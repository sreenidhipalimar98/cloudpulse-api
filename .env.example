# Environment variables for CloudPulse API
# Copy this file to .env and fill in the values
# Never commit .env to version control

# AWS region
AWS_REGION=ap-south-1

# AWS profile (for local development only)
AWS_PROFILE=cloudpulse

# Database credentials (injected from Secrets Manager in ECS, manual for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudpulse
DB_USER=cloudpulse_admin
DB_PASSWORD=changeme

# API settings
APP_ENV=development
LOG_LEVEL=info
